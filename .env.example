# Cadena de conexión directa a PostgreSQL en Supabase
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Secretos para firmar y validar JSON Web Tokens
JWT_ACCESS_SECRET="clave_secreta_para_access_token_minimo_32_caracteres"
JWT_REFRESH_SECRET="clave_secreta_para_refresh_token_minimo_32_caracteres"

# Tiempos de expiración de los tokens
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"