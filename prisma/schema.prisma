generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Booking {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @db.Uuid
  spaceId    String        @db.Uuid
  startTime  DateTime      @db.Timestamptz(6)
  endTime    DateTime      @db.Timestamptz(6)
  totalPrice Float
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @db.Timestamptz(6)
  Space      Space         @relation(fields: [spaceId], references: [id], onUpdate: NoAction, map: "fk_booking_space")
  User       User          @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_booking_user")

  @@index([spaceId, status, startTime, endTime], map: "idx_booking_space_time")
  @@index([userId, status, startTime, endTime], map: "idx_booking_user_time")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Space {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  description  String
  type         SpaceType
  pricePerHour Float
  imageUrl     String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  Booking      Booking[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  password     String    @db.VarChar(255)
  role         Role      @default(USER)
  refreshToken String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  Booking      Booking[]
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum SpaceType {
  DESK
  MEETING_ROOM
  BOOTH
}
